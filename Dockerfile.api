# API / trainer image: TensorFlow-free serving (LiteRT backbone + numpy head), ~150 MB RAM,
# small enough for free hosts such as Render (512 MB).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    INFERENCE_THREADS=1

WORKDIR /app

COPY requirements-api.txt .
RUN pip install -r requirements-api.txt

COPY src/ src/
COPY api/ api/
# Serving artifacts (see scripts/export_serving_model.py). A fresh named volume mounted at
# /app/models is initialised from these files, so retrained heads persist across restarts.
COPY models/backbone.tflite models/head.npz models/features_train.npz models/features_test.npz models/serving_meta.json models/
RUN useradd -m -u 1000 app && mkdir -p data/uploads && chown -R app:app /app
USER app

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://localhost:{os.getenv(\"PORT\", \"8000\")}/status', timeout=4)"

# PORT is set by hosts like Render; defaults to 8000 for docker compose.
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
